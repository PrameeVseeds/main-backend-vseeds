// GENERAL CONTENT & SETTINGS
// ==========================================

model Blog {
  id             String     @id @default(uuid()) @db.Char(36)
  title          String     @db.VarChar(200)
  slug           String     @unique @db.VarChar(200)
  excerpt        String?    @db.VarChar(500)
  content        String     @db.Text
  coverImageUrl  String?    @map("cover_image_url") @db.VarChar(500)
  author         String     @db.VarChar(100)
  tags           Json?
  status         BlogStatus @default(draft)
  publishedAt    DateTime?  @map("published_at") @db.DateTime(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?  @map("deleted_at") @db.DateTime(3)

  @@map("blogs")
}

model Banner {
  id           String     @id @default(uuid()) @db.Char(36)
  title        String     @db.VarChar(200)
  imageUrl     String     @map("image_url") @db.VarChar(500)
  linkUrl      String?    @map("link_url") @db.VarChar(500)
  deviceType   DeviceType @default(all) @map("device_type")
  displayOrder Int        @default(0) @map("display_order") @db.SmallInt
  isActive     Boolean    @default(true) @map("is_active")
  startsAt     DateTime?  @map("starts_at") @db.DateTime(3)
  endsAt       DateTime?  @map("ends_at") @db.DateTime(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("banners")
}

model FAQ {
  id           String    @id @default(uuid()) @db.Char(36)
  question     String    @db.VarChar(300)
  answer       String    @db.Text
  category     String?   @db.VarChar(100)
  site         FAQSite   @default(both)
  displayOrder Int       @default(0) @map("display_order") @db.SmallInt
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt    DateTime? @map("deleted_at") @db.DateTime(3)

  @@map("faqs")
}

model Contact {
  id        String        @id @default(uuid()) @db.Char(36)
  name      String        @db.VarChar(100)
  email     String        @db.VarChar(500)
  phone     String?       @db.VarChar(20)
  subject   String        @db.VarChar(200)
  message   String        @db.Text
  source    ContactSource @default(general)
  status    ContactStatus @default(new)
  createdAt DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime?     @map("deleted_at") @db.DateTime(3)

  replies   ContactReply[]
  history   ContactHistory[]

  @@map("contacts")
}

model ContactHistory {
  id        String   @id @default(uuid()) @db.Char(36)
  contactId String   @map("contact_id") @db.Char(36)
  action    String   @db.VarChar(20)
  snapshot  Json     @db.Json
  changedBy String?  @map("changed_by") @db.Char(36)
  changedAt DateTime @default(now()) @map("changed_at") @db.DateTime(3)

  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId], name: "idx_contacts_h_contact")
  @@index([changedAt], name: "idx_contacts_h_changed")
  @@map("contacts_h")
}

model ContactReply {
  id        String   @id @default(uuid()) @db.Char(36)
  contactId String   @map("contact_id") @db.Char(36)
  adminId   String   @map("admin_id") @db.Char(36)
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@map("contact_replies")
}

model Setting {
  id          String   @id @default(uuid()) @db.Char(36)
  key         String   @unique @map("setting_key") @db.VarChar(100)
  value       String   @map("setting_value") @db.Text
  valueType   String   @default("string") @map("value_type")
  group       String   @map("setting_group") @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("settings")
}

model Project {
  id           String   @id @default(uuid()) @db.Char(36)
  title        String   @db.VarChar(200)
  category     String   @db.VarChar(100)
  description  String   @db.Text
  imageUrl     String?  @map("image_url") @db.VarChar(500)
  technologies Json?
  displayOrder Int      @default(0) @map("display_order") @db.SmallInt
  isPublic     Boolean  @default(true) @map("is_public")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("projects")
}

model EmailTemplate {
  id          String   @id @default(uuid()) @db.Char(36)
  slug        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(100)
  category    String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  subject     String   @db.VarChar(200)
  htmlBody    String   @map("html_body") @db.Text
  textBody    String?  @map("text_body") @db.Text
  variables   Json?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)

  @@map("email_templates")
}
