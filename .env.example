# ─── Server ────────────────────────────────────────────────────
PORT=3004
NODE_ENV=development

# ─── Database (MySQL) ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DATABASE=your_database_name
DATABASE_URL=mysql://your_db_user:your_db_password@localhost:3306/your_database_name

# ─── JWT Secrets ───────────────────────────────────────────────
ACCESS_TOKEN_SECRET=change_me_to_a_secure_random_string
REFRESH_TOKEN_SECRET=change_me_to_another_secure_random_string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ─── Email (SMTP) ─────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=your_mail_password
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_BCC_SYSTEM=admin@example.com
MAIL_BCC_SALES=sales@example.com
MAIL_BCC_ALL=team@example.com

# ─── CORS Origins ─────────────────────────────────────────────
ADMIN_ORIGIN=http://localhost:4200
ELECTRONICS_ORIGIN=http://localhost:4201
EMBEDDED_ORIGIN=http://localhost:4202

# ─── Storage ──────────────────────────────────────────────────
# Local development: use a relative path from the project root
UPLOAD_DIR=./storage/uploads

# cPanel production: use the absolute path to your public_html uploads folder
# UPLOAD_DIR=/home/youraccount/public_html/upload_vseeds/images

MAX_FILE_SIZE=10485760

# ─── Activity Logging ─────────────────────────────────────────
DISABLE_ACTIVITY_LOGGING=false

# ─── 2FA ──────────────────────────────────────────────────────
TWO_FACTOR_APP_NAME=VSEEDS

# ─── Encryption ───────────────────────────────────────────────
# Generate key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=change_me_generate_a_32_byte_base64_key
ENCRYPTION_KEY_ID=v1

# ─── Sentry (Error Tracking) ────────────────────────────────
# Get your DSN from sentry.io to enable error tracking
SENTRY_DSN=

# ─── Super Admin Seed ──────────────────────────────────────────
SUPER_ADMIN_EMAIL=kajamohanofficial@gmail.com
SUPER_ADMIN_SECURITY=S33d$_1998_K@j@
